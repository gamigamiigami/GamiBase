{
  "name": "gamibase",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "license": "node --env-file-if-exists=.env server/admin.mjs",
    "build:netlify": "node scripts/build-netlify.mjs",
    "license:supabase": "node --use-env-proxy --env-file-if-exists=.env server/supabase-admin.mjs",
    "cloud:setup": "node --use-env-proxy --env-file-if-exists=.env scripts/cloud-setup.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14"
  }
}
