# Local example. For production, set these in your hosting service instead.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Set the code you distribute privately. Leave empty to disable coupon claims.
SHIGODEKI_COUPON_CODE=
# Defaults to a directory outside this static-site repository.
# SHIGODEKI_DATA_DIR=/absolute/private/path
# Netlify + Supabase: set these in the Netlify site's production environment.
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# Configuration delegation tokens belong in secure cloud environment settings.
# SUPABASE_ACCESS_TOKEN and NETLIFY_AUTH_TOKEN must never be committed.
